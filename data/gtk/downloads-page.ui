<?xml version="1.0" encoding="UTF-8"?>
<interface><object class="GtkBox" id="downloads_page"><property name="orientation">vertical</property><property name="spacing">12</property><property name="margin-start">20</property><property name="margin-end">20</property><property name="margin-top">12</property><property name="margin-bottom">12</property><property name="vexpand">true</property>
<child><object class="GtkStackSwitcher"><property name="stack">views</property><property name="halign">center</property></object></child>
<child><object class="GtkLabel" id="message"><property name="visible">false</property><property name="wrap">true</property><property name="xalign">0</property></object></child>
<child><object class="GtkStack" id="views"><property name="vexpand">true</property>
<child><object class="GtkStackPage"><property name="name">tasks</property><property name="title" translatable="yes">Download queue</property><property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property>
<child><object class="GtkLabel" id="task_summary"><property name="xalign">0</property><property name="wrap">true</property><style><class name="dim-label"/></style></object></child>
<child><object class="GtkBox"><property name="halign">center</property><style><class name="linked"/></style>
<child><object class="GtkToggleButton" id="tasks_all"><property name="label" translatable="yes">All</property><property name="active">true</property></object></child>
<child><object class="GtkToggleButton" id="tasks_complete"><property name="label" translatable="yes">Complete</property><property name="group">tasks_all</property></object></child>
<child><object class="GtkToggleButton" id="tasks_failed"><property name="label" translatable="yes">Failed</property><property name="group">tasks_all</property></object></child>
<child><object class="GtkToggleButton" id="tasks_active"><property name="label" translatable="yes">Active</property><property name="group">tasks_all</property></object></child>
</object></child>
<child><object class="GtkButton" id="clear_history"><property name="label" translatable="yes">Clear finished history</property><property name="halign">end</property></object></child>
<child><object class="AdwStatusPage" id="tasks_empty"><property name="title" translatable="yes">No downloads yet</property><property name="description" translatable="yes">Choose songs from a song list to start downloading</property><property name="icon-name">folder-download-symbolic</property><property name="vexpand">true</property></object></child><child><object class="GtkScrolledWindow" id="tasks_scroll"><property name="vexpand">true</property><property name="child"><object class="GtkListBox" id="tasks"><property name="selection-mode">none</property><property name="valign">start</property><style><class name="boxed-list"/></style></object></property></object></child>
</object></property></object></child>
<child><object class="GtkStackPage"><property name="name">saved</property><property name="title" translatable="yes">Saved files</property><property name="child"><object class="GtkBox"><property name="orientation">vertical</property><property name="spacing">12</property>
<child><object class="GtkSearchEntry" id="search"><property name="placeholder-text" translatable="yes">Search songs or folders</property></object></child>
<child><object class="GtkDropDown" id="location_filter"><property name="tooltip-text" translatable="yes">Save location</property></object></child>
<child><object class="GtkBox"><property name="spacing">6</property><child><object class="GtkButton" id="refresh"><property name="icon-name">view-refresh-symbolic</property><property name="tooltip-text" translatable="yes">Refresh file status</property></object></child><child><object class="GtkButton" id="scan"><property name="label" translatable="yes">Scan folder</property></object></child><child><object class="GtkButton" id="select_all"><property name="label" translatable="yes">Select visible</property></object></child><child><object class="GtkButton" id="delete"><property name="label" translatable="yes">Delete selected</property><style><class name="destructive-action"/></style></object></child><child><object class="GtkMenuButton"><property name="icon-name">view-more-symbolic</property><property name="menu-model">file_menu</property></object></child></object></child>
<child><object class="GtkBox"><property name="spacing">6</property>
<child><object class="GtkButton" id="folder_up"><property name="icon-name">go-up-symbolic</property><property name="tooltip-text" translatable="yes">Parent folder</property></object></child>
<child><object class="GtkLabel" id="folder_path"><property name="xalign">0</property><property name="hexpand">true</property><property name="ellipsize">middle</property><style><class name="dim-label"/></style></object></child>
</object></child>
<child><object class="GtkLabel" id="file_count"><property name="xalign">0</property><style><class name="dim-label"/></style></object></child>
<child><object class="AdwStatusPage" id="files_empty"><property name="title" translatable="yes">No saved files</property><property name="description" translatable="yes">Download songs or scan a folder to manage existing MP3 files</property><property name="icon-name">folder-music-symbolic</property><property name="vexpand">true</property></object></child><child><object class="GtkScrolledWindow" id="files_scroll"><property name="vexpand">true</property><property name="child"><object class="GtkListBox" id="files"><property name="selection-mode">none</property><property name="valign">start</property><style><class name="boxed-list"/></style></object></property></object></child>
</object></property></object></child>
</object></child></object>
<menu id="file_menu"><item><attribute name="label" translatable="yes">Remove missing entries</attribute><attribute name="action">downloads.remove-missing</attribute></item></menu>
</interface>
