<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0" />
    <template class="SongListView" parent="GtkBox"><property name="orientation">vertical</property>
<child><object class="GtkBox"><property name="spacing">8</property><property name="margin-start">20</property><property name="margin-end">20</property><property name="margin-top">8</property>
<child><object class="GtkButton" id="selection_toggle"><property name="label" translatable="yes">Select songs</property><style><class name="flat"/></style></object></child>
<child><object class="GtkButton" id="select_all"><property name="visible">false</property><property name="label" translatable="yes">Select all loaded songs</property><property name="tooltip-text" translatable="yes">Only songs currently loaded in this view are selected</property></object></child>
<child><object class="GtkButton" id="download_selected"><property name="visible">false</property><property name="label" translatable="yes">Download selected</property><style><class name="suggested-action"/></style></object></child>
</object></child>
        <child>
            <object class="GtkScrolledWindow" id="scroll_win"><property name="vexpand">true</property>
                <child>
                    <object class="GtkViewport">
                        <property name="scroll-to-focus">True</property>
                        <child>
                            <object class="AdwClamp" id="adw_clamp">
                                <property name="vexpand">true</property>
                                <property name="hexpand">true</property>
                                <property name="maximum-size">1000</property>
                                <property name="tightening-threshold">730</property>
                                <property name="margin-top">10</property>
                                <property name="margin-bottom">10</property>
                                <property name="margin-start">20</property>
                                <property name="margin-end">20</property>
                                <child>
                                    <object class="GtkListBox" id="listbox">
                                        <property name="valign">start</property>
                                        <style>
                                            <class name="boxed-list" />
                                        </style>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
    </template>
</interface>
